<?xml version="1.0" encoding="UTF-8"?>
<!--
  Apache FOP configuration for GitHub Actions PDF output.

  The open-source DITA-OT PDF2 transformation uses Apache FOP. Ubuntu's Noto CJK
  fonts are OpenType CFF collections, which this FOP version may fail to embed.
  The workflow therefore installs WenQuanYi Micro Hei, a TrueType collection
  that FOP can embed reliably, and maps the CJK font names generated by
  font-mappings-zh-cn.xml to that font.
-->
<fop version="1.0">
  <strict-validation>false</strict-validation>
  <base>.</base>
  <source-resolution>120</source-resolution>
  <target-resolution>600</target-resolution>
  <default-page-settings height="11.00in" width="8.50in"/>

  <renderers>
    <renderer mime="application/pdf">
      <filterList>
        <value>flate</value>
      </filterList>

      <fonts>
        <font kerning="yes"
              embed-url="/usr/share/fonts/truetype/wqy/wqy-microhei.ttc"
              sub-font="WenQuanYi Micro Hei">
          <font-triplet name="Noto Sans CJK SC" style="normal" weight="normal"/>
          <font-triplet name="Noto Sans CJK SC" style="italic" weight="normal"/>
          <font-triplet name="Noto Sans CJK SC" style="normal" weight="bold"/>
          <font-triplet name="Noto Sans CJK SC" style="italic" weight="bold"/>
          <font-triplet name="Noto Serif CJK SC" style="normal" weight="normal"/>
          <font-triplet name="Noto Serif CJK SC" style="italic" weight="normal"/>
          <font-triplet name="Noto Serif CJK SC" style="normal" weight="bold"/>
          <font-triplet name="Noto Serif CJK SC" style="italic" weight="bold"/>
        </font>

        <font kerning="yes"
              embed-url="/usr/share/fonts/truetype/wqy/wqy-microhei.ttc"
              sub-font="WenQuanYi Micro Hei Mono">
          <font-triplet name="Noto Sans Mono CJK SC" style="normal" weight="normal"/>
          <font-triplet name="Noto Sans Mono CJK SC" style="italic" weight="normal"/>
          <font-triplet name="Noto Sans Mono CJK SC" style="normal" weight="bold"/>
          <font-triplet name="Noto Sans Mono CJK SC" style="italic" weight="bold"/>
        </font>
      </fonts>
    </renderer>
  </renderers>
</fop>
